{
    "name": "salioudiabate/notify",
    "description": "A unified notification & feedback UI system for Laravel and Livewire — toasts, alerts, confirmations, dialogs, loading and progress from one fluent API. Works standalone in plain Laravel; upgrades itself automatically to real-time, no-reload notifications the moment Livewire is present.",
    "keywords": [
        "laravel",
        "livewire",
        "notifications",
        "toast",
        "alert",
        "confirm",
        "dialog",
        "ui"
    ],
    "homepage": "https://github.com/salioudiabate/notify",
    "license": "MIT",
    "authors": [
        {
            "name": "Saliou Diabate",
            "email": "saliou.diiabate@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/serializable-closure": "^1.3|^2.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "suggest": {
        "livewire/livewire": "Enables the InteractsWithNotifications trait and no-reload, real-time notifications. Notify works fully without it — this only upgrades the experience. Supports ^3.0 and ^4.0: the integration uses only Livewire's public dispatch()/on() API, never internals, so both versions behave identically."
    },
    "autoload": {
        "psr-4": {
            "Salioudiabate\\Notify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Salioudiabate\\Notify\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Salioudiabate\\Notify\\NotifyServiceProvider"
            ],
            "aliases": {
                "Notify": "Salioudiabate\\Notify\\Facades\\Notify"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
